{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "paths": {
      "@openlearnos/contracts": ["../../packages/contracts/src/index.ts"],
      "@openlearnos/core": ["../../packages/core/src/index.ts"],
      "@openlearnos/ui": ["../../packages/ui/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
