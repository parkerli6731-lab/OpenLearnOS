{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenLearnOS",
  "version": "0.3.0",
  "identifier": "org.openlearnos.desktop",
  "build": {
    "beforeDevCommand": "npm --workspace=@openlearnos/web run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "VITE_BASE_PATH=\"./\" npm --workspace=@openlearnos/web run build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenLearnOS — 零门槛 AI-Native 开放学习操作系统",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}
